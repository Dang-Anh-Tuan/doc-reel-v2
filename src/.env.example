# =====================================================================
# DocReel — mẫu biến môi trường
# Copy thành ".env" ở THƯ MỤC GỐC repo (cạnh SPEC.md), điền giá trị thật.
# ".env" không được commit. Giọng / tốc độ là hằng số trong application.yml (SPEC mục 8).
# =====================================================================

# --- Database — PostgreSQL 16 (compose.yaml) -------------------------
POSTGRES_DB=docreel
POSTGRES_USER=docreel
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/docreel
SPRING_DATASOURCE_USERNAME=docreel
SPRING_DATASOURCE_PASSWORD=change-me

# --- Thư mục làm việc (SPEC mục 4, 10) -------------------------------
DOCREEL_DIR_INBOX=./data/inbox
DOCREEL_DIR_REQUESTS=./data/requests
DOCREEL_DIR_WORK=./data/work
DOCREEL_DIR_DONE=./data/done
DOCREEL_DIR_FAILED=./data/failed
DOCREEL_DIR_DUPLICATE=./data/duplicate

# --- Công cụ ngoài — để trống nếu đã có trong PATH --------------------
FFMPEG_PATH=
FFPROBE_PATH=
PLAYWRIGHT_CHROMIUM_EXECUTABLE=

# --- Giọng chính — ElevenLabs (Free) — SPEC mục 8 ---------------------
# https://elevenlabs.io/app/settings/api-keys
# Quyền cần bật: Text to Speech, Voices (read), User (read)
ELEVENLABS_API_KEY=

# --- Giọng dự phòng — edge-tts (miễn phí, KHÔNG cần key) --------------
# Cài: pip install edge-tts
# Để trống nếu lệnh "edge-tts" đã có trong PATH
EDGE_TTS_COMMAND=

# --- YouTube Data API v3 — OAuth "Desktop app" -----------------------
# Refresh token không để ở đây: lệnh --youtube-auth lưu mã hóa vào file.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_TOKEN_FILE=./data/secrets/youtube-token.enc
# Chuỗi ngẫu nhiên ≥ 32 ký tự (vd: openssl rand -base64 32)
YOUTUBE_TOKEN_ENCRYPTION_KEY=

# --- Bản 2 — kênh chat (SPEC mục 10). Trống = tắt ---------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
ZALO_BOT_TOKEN=
ZALO_ALLOWED_CHAT_IDS=

# --- Bản 2 — Basic Auth /admin + /api khi lên VPS (PLAN P18) ----------
DOCREEL_ADMIN_USERNAME=
# Mã BCrypt, không để mật khẩu gốc
DOCREEL_ADMIN_PASSWORD_BCRYPT=

# --- Khác -------------------------------------------------------------
# dev | prod | e2e  (e2e dùng TTS + YouTube giả, PLAN mục 2.5)
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080